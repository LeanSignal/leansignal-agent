<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.leansignal.tempo</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/tempo</string>
        <string>-config.file=/usr/local/etc/leansignal-agent/tempo.yaml</string>
    </array>
    <!-- Soft heap target: no cgroup memory limit on a host install, so
         GOMEMLIMIT is Tempo's effective ceiling (GC backpressure instead of
         OOM). ~650MiB matches the k8s chart's 1Gi-limit tuning. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>GOMEMLIMIT</key>
        <string>650MiB</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/leansignal-agent/tempo.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/leansignal-agent/tempo.log</string>
</dict>
</plist>
