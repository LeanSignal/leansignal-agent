<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.leansignal.loki</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/loki</string>
        <string>-config.file=/usr/local/etc/leansignal-agent/loki.yaml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/leansignal-agent/loki.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/leansignal-agent/loki.log</string>
</dict>
</plist>
